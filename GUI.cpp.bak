static HWND billingFormWindow = NULL;

static HWND billCustomerIdBox = NULL;
static HWND billMedicineIdBox = NULL;
static HWND billQuantityBox = NULL;

static HWND billCustomerNameBox = NULL;
static HWND billDateBox = NULL;

static HWND billItemsList = NULL;
static HWND billTotalLabel = NULL;

static Bill* activeBill = NULL;


// ------------------------------------------------------------
// Get text from billing control
// ------------------------------------------------------------

static string getBillingText(HWND control)
{
    char buffer[500];

    GetWindowTextA(
        control,
        buffer,
        sizeof(buffer)
    );

    return string(buffer);
}


// ------------------------------------------------------------
// Set text in billing control
// ------------------------------------------------------------

static void setBillingText(
    HWND control,
    string value
)
{
    if (control != NULL)
    {
        SetWindowTextA(
            control,
            value.c_str()
        );
    }
}


// ------------------------------------------------------------
// Create billing edit box
// ------------------------------------------------------------

static HWND createBillingEdit(
    HWND parent,
    int x,
    int y,
    int width,
    int height,
    string value
)
{
    HWND editBox =
        CreateWindowExA(
            WS_EX_CLIENTEDGE,
            "EDIT",
            value.c_str(),
            WS_CHILD |
            WS_VISIBLE |
            WS_BORDER |
            ES_AUTOHSCROLL,
            x,
            y,
            width,
            height,
            parent,
            NULL,
            GetModuleHandle(NULL),
            NULL
        );

    SendMessageA(
        editBox,
        WM_SETFONT,
        (WPARAM)GetStockObject(DEFAULT_GUI_FONT),
        TRUE
    );

    return editBox;
}


// ------------------------------------------------------------
// Add text to bill items list
// ------------------------------------------------------------

static void addBillListText(
    string text
)
{
    if (billItemsList == NULL)
        return;

    SendMessageA(
        billItemsList,
        LB_ADDSTRING,
        0,
        (LPARAM)text.c_str()
    );
}


// ------------------------------------------------------------
// Refresh current bill display
// ------------------------------------------------------------

static void refreshBillDisplay()
{
    if (billItemsList == NULL ||
        activeBill == NULL)
    {
        return;
    }

    SendMessageA(
        billItemsList,
        LB_RESETCONTENT,
        0,
        0
    );


    BillItem* current =
        activeBill->getHead();


    while (current != NULL)
    {
        Medicine medicine =
            current->getMedicine();

        string row =
            "ID: " +
            to_string(
                medicine.getMedicineID()
            ) +
            "    " +
            medicine.getName() +
            "    Qty: " +
            to_string(
                current->getQuantity()
            ) +
            "    Price: " +
            to_string(
                medicine.getPrice()
            ) +
            "    Amount: " +
            to_string(
                current->getAmount()
            );


        addBillListText(
            row
        );


        current =
            current->next;
    }


    string total =
        "Grand Total: Rs. " +
        to_string(
            activeBill->calculateTotal()
        );


    setBillingText(
        billTotalLabel,
        total
    );
}


// ------------------------------------------------------------
// Billing form procedure
// ------------------------------------------------------------

static LRESULT CALLBACK BillingFormProcedure(
    HWND window,
    UINT message,
    WPARAM wParam,
    LPARAM lParam
)
{
    switch (message)
    {
        case WM_CREATE:
        {
            HINSTANCE instance =
                GetModuleHandle(NULL);

            HFONT font =
                (HFONT)GetStockObject(DEFAULT_GUI_FONT);


            // ----------------------------------------
            // Title
            // ----------------------------------------

            HWND title =
                CreateWindowExA(
                    0,
                    "STATIC",
                    "PharmaCare - New Bill",
                    WS_CHILD |
                    WS_VISIBLE |
                    SS_LEFT,
                    30,
                    20,
                    500,
                    30,
                    window,
                    NULL,
                    instance,
                    NULL
                );

            SendMessageA(
                title,
                WM_SETFONT,
                (WPARAM)font,
                TRUE
            );


            // ----------------------------------------
            // Customer ID
            // ----------------------------------------

            HWND customerIDLabel =
                CreateWindowExA(
                    0,
                    "STATIC",
                    "Customer ID",
                    WS_CHILD |
                    WS_VISIBLE,
                    30,
                    70,
                    120,
                    25,
                    window,
                    NULL,
                    instance,
                    NULL
                );

            SendMessageA(
                customerIDLabel,
                WM_SETFONT,
                (WPARAM)font,
                TRUE
            );


            billCustomerIdBox =
                createBillingEdit(
                    window,
                    150,
                    65,
                    180,
                    30,
                    ""
                );


            // ----------------------------------------
            // Customer Name
            // ----------------------------------------

            HWND customerNameLabel =
                CreateWindowExA(
                    0,
                    "STATIC",
                    "Customer Name",
                    WS_CHILD |
                    WS_VISIBLE,
                    350,
                    70,
                    120,
                    25,
                    window,
                    NULL,
                    instance,
                    NULL
                );

            SendMessageA(
                customerNameLabel,
                WM_SETFONT,
                (WPARAM)font,
                TRUE
            );


            billCustomerNameBox =
                createBillingEdit(
                    window,
                    470,
                    65,
                    180,
                    30,
                    ""
                );


            // ----------------------------------------
            // Date
            // ----------------------------------------

            HWND dateLabel =
                CreateWindowExA(
                    0,
                    "STATIC",
                    "Date",
                    WS_CHILD |
                    WS_VISIBLE,
                    30,
                    115,
                    120,
                    25,
                    window,
                    NULL,
                    instance,
                    NULL
                );

            SendMessageA(
                dateLabel,
                WM_SETFONT,
                (WPARAM)font,
                TRUE
            );


            string today =
                "Today";


            billDateBox =
                createBillingEdit(
                    window,
                    150,
                    110,
                    180,
                    30,
                    today
                );


            // ----------------------------------------
            // Medicine ID
            // ----------------------------------------

            HWND medicineIDLabel =
                CreateWindowExA(
                    0,
                    "STATIC",
                    "Medicine ID",
                    WS_CHILD |
                    WS_VISIBLE,
                    30,
                    170,
                    120,
                    25,
                    window,
                    NULL,
                    instance,
                    NULL
                );

            SendMessageA(
                medicineIDLabel,
                WM_SETFONT,
                (WPARAM)font,
                TRUE
            );


            billMedicineIdBox =
                createBillingEdit(
                    window,
                    150,
                    165,
                    180,
                    30,
                    ""
                );


            // ----------------------------------------
            // Quantity
            // ----------------------------------------

            HWND quantityLabel =
                CreateWindowExA(
                    0,
                    "STATIC",
                    "Quantity",
                    WS_CHILD |
                    WS_VISIBLE,
                    350,
                    170,
                    120,
                    25,
                    window,
                    NULL,
                    instance,
                    NULL
                );

            SendMessageA(
                quantityLabel,
                WM_SETFONT,
                (WPARAM)font,
                TRUE
            );


            billQuantityBox =
                createBillingEdit(
                    window,
                    470,
                    165,
                    180,
                    30,
                    ""
                );


            // ----------------------------------------
            // Add Item button
            // ----------------------------------------

            HWND addItemButton =
                CreateWindowExA(
                    0,
                    "BUTTON",
                    "Add Medicine",
                    WS_CHILD |
                    WS_VISIBLE |
                    BS_PUSHBUTTON,
                    670,
                    160,
                    130,
                    40,
                    window,
                    (HMENU)2001,
                    instance,
                    NULL
                );

            SendMessageA(
                addItemButton,
                WM_SETFONT,
                (WPARAM)font,
                TRUE
            );


            // ----------------------------------------
            // Items label
            // ----------------------------------------

            HWND itemsLabel =
                CreateWindowExA(
                    0,
                    "STATIC",
                    "Bill Items",
                    WS_CHILD |
                    WS_VISIBLE,
                    30,
                    225,
                    150,
                    25,
                    window,
                    NULL,
                    instance,
                    NULL
                );

            SendMessageA(
                itemsLabel,
                WM_SETFONT,
                (WPARAM)font,
                TRUE
            );


            // ----------------------------------------
            // Bill items list
            // ----------------------------------------

            billItemsList =
                CreateWindowExA(
                    WS_EX_CLIENTEDGE,
                    "LISTBOX",
                    "",
                    WS_CHILD |
                    WS_VISIBLE |
                    WS_BORDER |
                    LBS_NOTIFY |
                    WS_VSCROLL,
                    30,
                    255,
                    770,
                    190,
                    window,
                    NULL,
                    instance,
                    NULL
                );

            SendMessageA(
                billItemsList,
                WM_SETFONT,
                (WPARAM)font,
                TRUE
            );


            // ----------------------------------------
            // Grand total
            // ----------------------------------------

            billTotalLabel =
                CreateWindowExA(
                    0,
                    "STATIC",
                    "Grand Total: Rs. 0.00",
                    WS_CHILD |
                    WS_VISIBLE |
                    SS_LEFT,
                    30,
                    465,
                    350,
                    30,
                    window,
                    NULL,
                    instance,
                    NULL
                );

            SendMessageA(
                billTotalLabel,
                WM_SETFONT,
                (WPARAM)font,
                TRUE
            );


            // ----------------------------------------
            // Generate Bill
            // ----------------------------------------

            HWND generateButton =
                CreateWindowExA(
                    0,
                    "BUTTON",
                    "Generate Bill",
                    WS_CHILD |
                    WS_VISIBLE |
                    BS_PUSHBUTTON,
                    450,
                    460,
                    160,
                    40,
                    window,
                    (HMENU)2002,
                    instance,
                    NULL
                );

            SendMessageA(
                generateButton,
                WM_SETFONT,
                (WPARAM)font,
                TRUE
            );


            // ----------------------------------------
            // Close
            // ----------------------------------------

            HWND closeButton =
                CreateWindowExA(
                    0,
                    "BUTTON",
                    "Close",
                    WS_CHILD |
                    WS_VISIBLE |
                    BS_PUSHBUTTON,
                    630,
                    460,
                    170,
                    40,
                    window,
                    (HMENU)2003,
                    instance,
                    NULL
                );

            SendMessageA(
                closeButton,
                WM_SETFONT,
                (WPARAM)font,
                TRUE
            );


            refreshBillDisplay();

            return 0;
        }


        case WM_COMMAND:
        {
            int controlID =
                LOWORD(wParam);


            // ----------------------------------------
            // Add Medicine
            // ----------------------------------------

            if (controlID == 2001)
            {
                if (activeBill == NULL)
                {
                    MessageBoxA(
                        window,
                        "Please create a bill first.",
                        "PharmaCare",
                        MB_OK |
                        MB_ICONWARNING
                    );

                    return 0;
                }


                string medicineIDText =
                    getBillingText(
                        billMedicineIdBox
                    );

                string quantityText =
                    getBillingText(
                        billQuantityBox
                    );


                if (medicineIDText.empty() ||
                    quantityText.empty())
                {
                    MessageBoxA(
                        window,
                        "Please enter Medicine ID and Quantity.",
                        "PharmaCare",
                        MB_OK |
                        MB_ICONWARNING
                    );

                    return 0;
                }


                int medicineID =
                    atoi(
                        medicineIDText.c_str()
                    );

                int quantity =
                    atoi(
                        quantityText.c_str()
                    );


                if (medicineID <= 0 ||
                    quantity <= 0)
                {
                    MessageBoxA(
                        window,
                        "Medicine ID and Quantity must be greater than zero.",
                        "PharmaCare",
                        MB_OK |
                        MB_ICONWARNING
                    );

                    return 0;
                }


                if (g_medicineManager == NULL)
                {
                    MessageBoxA(
                        window,
                        "Medicine manager is unavailable.",
                        "PharmaCare",
                        MB_OK |
                        MB_ICONERROR
                    );

                    return 0;
                }


                Medicine* medicine =
                    g_medicineManager->searchMedicine(
                        medicineID
                    );


                if (medicine == NULL)
                {
                    MessageBoxA(
                        window,
                        "Medicine not found.",
                        "PharmaCare",
                        MB_OK |
                        MB_ICONWARNING
                    );

                    return 0;
                }


                if (medicine->getQuantity() < quantity)
                {
                    MessageBoxA(
                        window,
                        "Insufficient stock available.",
                        "PharmaCare",
                        MB_OK |
                        MB_ICONWARNING
                    );

                    return 0;
                }


                if (activeBill->addItem(
                        *medicine,
                        quantity))
                {
                    refreshBillDisplay();

                    setBillingText(
                        billMedicineIdBox,
                        ""
                    );

                    setBillingText(
                        billQuantityBox,
                        ""
                    );
                }
                else
                {
                    MessageBoxA(
                        window,
                        "Unable to add medicine to bill.",
                        "PharmaCare",
                        MB_OK |
                        MB_ICONERROR
                    );
                }


                return 0;
            }


            // ----------------------------------------
            // Generate Bill
            // ----------------------------------------

            if (controlID == 2002)
            {
                if (activeBill == NULL)
                {
                    MessageBoxA(
                        window,
                        "No bill has been created.",
                        "PharmaCare",
                        MB_OK |
                        MB_ICONWARNING
                    );

                    return 0;
                }


                if (activeBill->getHead() == NULL)
                {
                    MessageBoxA(
                        window,
                        "Please add at least one medicine.",
                        "PharmaCare",
                        MB_OK |
                        MB_ICONWARNING
                    );

                    return 0;
                }


                // Reduce stock for every item.
                BillItem* item =
                    activeBill->getHead();
                bool stockUpdated = true;    
                while (item != NULL)
                {
                    Medicine medicine =
                        item->getMedicine();


                    if (g_medicineManager == NULL ||
                        !g_medicineManager->reduceStock(
                            medicine.getMedicineID(),
                            item->getQuantity()))
                    {
                        stockUpdated =
                            false;

                        break;
                    }


                    item =
                        item->next;
                }


                if (!stockUpdated)
                {
                    MessageBoxA(
                        window,
                        "Unable to update medicine stock.",
                        "PharmaCare",
                        MB_OK |
                        MB_ICONERROR
                    );

                    return 0;
                }


                if (g_billManager != NULL)
{
    // Add sale record
    if (g_saleManager != NULL)
    {
        g_saleManager->addSale(
            activeBill->getBillNumber(),
            activeBill->getDate(),
            activeBill->getAmount()
        );
    }

    // Save all data
    if (g_dataManager != NULL)
    {
        g_dataManager->saveAll(
            *g_medicineManager,
            *g_customerManager,
            *g_billManager,
            *g_saleManager
        );
    }

    MessageBoxA(
        window,
        "Bill generated successfully and saved.",
        "PharmaCare",
        MB_OK |
        MB_ICONINFORMATION
    );

    DestroyWindow(window);
}


                return 0;
            }


            // ----------------------------------------
            // Close
            // ----------------------------------------

            if (controlID == 2003)
            {
                DestroyWindow(
                    window
                );

                return 0;
            }


            break;
        }


        case WM_CLOSE:
        {
            DestroyWindow(
                window
            );

            return 0;
        }


        case WM_DESTROY:
        {
            billingFormWindow = NULL;

            billCustomerIdBox = NULL;
            billMedicineIdBox = NULL;
            billQuantityBox = NULL;
            billCustomerNameBox = NULL;
            billDateBox = NULL;
            billItemsList = NULL;
            billTotalLabel = NULL;

            activeBill = NULL;

            return 0;
        }
    }


    return DefWindowProcA(
        window,
        message,
        wParam,
        lParam
    );
}


// ------------------------------------------------------------
// Open New Bill Form
// ------------------------------------------------------------

void GUI::createNewBill()
{
    if (billManager == NULL)
    {
        MessageBoxA(
            NULL,
            "Bill manager is unavailable.",
            "PharmaCare",
            MB_OK |
            MB_ICONERROR
        );

        return;
    }


    HINSTANCE instance =
        GetModuleHandle(NULL);


    WNDCLASSA formClass;

    ZeroMemory(
        &formClass,
        sizeof(formClass)
    );


    formClass.lpfnWndProc =
        BillingFormProcedure;

    formClass.hInstance =
        instance;

    formClass.lpszClassName =
        "PharmaCareBillingForm";

    formClass.hCursor =
        LoadCursor(
            NULL,
            IDC_ARROW
        );

    formClass.hbrBackground =
        (HBRUSH)(COLOR_WINDOW + 1);


    RegisterClassA(
        &formClass
    );


    string customerIDText;


    // Ask customer ID through the complete form.
    // The actual bill object is created after the form
    // receives the customer information.


    int customerID =
        0;


    char inputBuffer[100];

    ZeroMemory(
        inputBuffer,
        sizeof(inputBuffer)
    );


    // Create a temporary complete billing form.
    // Customer information is entered directly in the form.


    string date =
        getCurrentDate();


    // A temporary customer ID of zero is replaced when
    // the user starts the actual billing workflow.


    activeBill =
        billManager->createBill(
            0,
            "",
            date
        );

    currentBill = activeBill;
    if (activeBill == NULL)
    {
        MessageBoxA(
            NULL,
            "Unable to create a new bill.",
            "PharmaCare",
            MB_OK |
            MB_ICONERROR
        );

        return;
    }


    billingFormWindow =
        CreateWindowExA(
            WS_EX_DLGMODALFRAME,
            "PharmaCareBillingForm",
            "PharmaCare - New Bill",
            WS_OVERLAPPED |
            WS_CAPTION |
            WS_SYSMENU,
            250,
            80,
            850,
            570,
            NULL,
            NULL,
            instance,
            NULL
        );


    if (billingFormWindow == NULL)
    {
        delete activeBill;
        activeBill = NULL;

        MessageBoxA(
            NULL,
            "Unable to open billing window.",
            "PharmaCare",
            MB_OK |
            MB_ICONERROR
        );

        return;
    }


    ShowWindow(
        billingFormWindow,
        SW_SHOW
    );

    UpdateWindow(
        billingFormWindow
    );


    MSG message;


    while (
        billingFormWindow != NULL &&
        GetMessageA(
            &message,
            NULL,
            0,
            0
        ) > 0
    )
    {
        TranslateMessage(
            &message
        );

        DispatchMessageA(
            &message
        );
    }
    InvalidateRect(
    NULL,
    NULL,
    TRUE
);
}


// ------------------------------------------------------------
// Add medicine to current bill
// ------------------------------------------------------------

void GUI::addMedicineToCurrentBill()
{
    if (currentBill == NULL)
    {
        MessageBoxA(
            NULL,
            "No active bill.",
            "PharmaCare",
            MB_OK |
            MB_ICONWARNING
        );

        return;
    }
}

// ============================================================
// END OF PART 3
// ============================================================
// ============================================================
// PHARMACARE GUI - PART 4A
// SALES HISTORY + DAILY SALES
// ============================================================

static HWND salesWindow = NULL;
static HWND salesList = NULL;
static HWND salesTotalLabel = NULL;


// ------------------------------------------------------------
// Add text to sales list
// ------------------------------------------------------------

static void addSalesListText(string text)
{
    if (salesList == NULL)
        return;

    SendMessageA(
        salesList,
        LB_ADDSTRING,
        0,
        (LPARAM)text.c_str()
    );
}


// ------------------------------------------------------------
// Sales Window Procedure
// ------------------------------------------------------------

static LRESULT CALLBACK SalesWindowProcedure(
    HWND window,
    UINT message,
    WPARAM wParam,
    LPARAM lParam
)
{
    switch (message)
    {
        case WM_CREATE:
        {
            HINSTANCE instance =
                GetModuleHandle(NULL);

            HFONT font =
                (HFONT)GetStockObject(DEFAULT_GUI_FONT);


            HWND title =
                CreateWindowExA(
                    0,
                    "STATIC",
                    "PharmaCare - Sales History",
                    WS_CHILD |
                    WS_VISIBLE,
                    30,
                    20,
                    500,
                    30,
                    window,
                    NULL,
                    instance,
                    NULL
                );

            SendMessageA(
                title,
                WM_SETFONT,
                (WPARAM)font,
                TRUE
            );


            salesList =
                CreateWindowExA(
                    WS_EX_CLIENTEDGE,
                    "LISTBOX",
                    "",
                    WS_CHILD |
                    WS_VISIBLE |
                    WS_BORDER |
                    WS_VSCROLL |
                    LBS_NOINTEGRALHEIGHT,
                    30,
                    70,
                    760,
                    360,
                    window,
                    NULL,
                    instance,
                    NULL
                );

            SendMessageA(
                salesList,
                WM_SETFONT,
                (WPARAM)font,
                TRUE
            );


            salesTotalLabel =
                CreateWindowExA(
                    0,
                    "STATIC",
                    "Total Income: Rs. 0.00",
                    WS_CHILD |
                    WS_VISIBLE,
                    30,
                    450,
                    350,
                    30,
                    window,
                    NULL,
                    instance,
                    NULL
                );

            SendMessageA(
                salesTotalLabel,
                WM_SETFONT,
                (WPARAM)font,
                TRUE
            );


            HWND closeButton =
                CreateWindowExA(
                    0,
                    "BUTTON",
                    "Close",
                    WS_CHILD |
                    WS_VISIBLE |
                    BS_PUSHBUTTON,
                    650,
                    445,
                    140,
                    40,
                    window,
                    (HMENU)4001,
                    instance,
                    NULL
                );

            SendMessageA(
                closeButton,
                WM_SETFONT,
                (WPARAM)font,
                TRUE
            );


            return 0;
        }


        case WM_COMMAND:
        {
            if (LOWORD(wParam) == 4001)
            {
                DestroyWindow(window);

                return 0;
            }

            break;
        }


        case WM_CLOSE:
        {
            DestroyWindow(window);

            return 0;
        }


        case WM_DESTROY:
        {
            salesWindow = NULL;
            salesList = NULL;
            salesTotalLabel = NULL;

            return 0;
        }
    }


    return DefWindowProcA(
        window,
        message,
        wParam,
        lParam
    );
}


// ------------------------------------------------------------
// Show Sales History
// ------------------------------------------------------------

void GUI::showSalesHistory()
{
    if (saleManager == NULL)
    {
        MessageBoxA(
            NULL,
            "Sales manager is unavailable.",
            "PharmaCare",
            MB_OK |
            MB_ICONERROR
        );

        return;
    }


    HINSTANCE instance =
        GetModuleHandle(NULL);


    WNDCLASSA salesClass;

    ZeroMemory(
        &salesClass,
        sizeof(salesClass)
    );


    salesClass.lpfnWndProc =
        SalesWindowProcedure;

    salesClass.hInstance =
        instance;

    salesClass.lpszClassName =
        "PharmaCareSalesWindow";

    salesClass.hCursor =
        LoadCursor(
            NULL,
            IDC_ARROW
        );

    salesClass.hbrBackground =
        (HBRUSH)(COLOR_WINDOW + 1);


    RegisterClassA(
        &salesClass
    );


    salesWindow =
        CreateWindowExA(
            WS_EX_DLGMODALFRAME,
            "PharmaCareSalesWindow",
            "PharmaCare - Sales History",
            WS_OVERLAPPED |
            WS_CAPTION |
            WS_SYSMENU,
            300,
            100,
            850,
            550,
            NULL,
            NULL,
            instance,
            NULL
        );


    if (salesWindow == NULL)
    {
        MessageBoxA(
            NULL,
            "Unable to open Sales History.",
            "PharmaCare",
            MB_OK |
            MB_ICONERROR
        );

        return;
    }


    ShowWindow(
        salesWindow,
        SW_SHOW
    );

    UpdateWindow(
        salesWindow
    );


    // --------------------------------------------------------
    // Display sales
    // --------------------------------------------------------

    int salesCount =
        saleManager->getCount();


    double totalIncome =
        0.0;


    for (int i = 0; i < salesCount; i++)
    {
        Sale* sale =
            saleManager->getSaleAt(i);


        if (sale == NULL)
            continue;


        string row =
            "Sale ID: " +
            to_string(
                sale->getSaleID()
            ) +
            "    Bill No: " +
            to_string(
                sale->getBillNumber()
            ) +
            "    Date: " +
            sale->getDate() +
            "    Amount: Rs. " +
            to_string(
                sale->getAmount()
            );


        addSalesListText(
            row
        );


        totalIncome +=
            sale->getAmount();
    }


    string totalText =
        "Total Income: Rs. " +
        to_string(
            totalIncome
        );


    SetWindowTextA(
        salesTotalLabel,
        totalText.c_str()
    );


    MSG message;


    while (
        salesWindow != NULL &&
        GetMessageA(
            &message,
            NULL,
            0,
            0
        ) > 0
    )
    {
        TranslateMessage(
            &message
        );

        DispatchMessageA(
            &message
        );
    }


    InvalidateRect(
        NULL,
        NULL,
        TRUE
    );
}


// ------------------------------------------------------------
// Show Daily Sales
// ------------------------------------------------------------

void GUI::showDailySales()
{
    if (saleManager == NULL)
    {
        MessageBoxA(
            NULL,
            "Sales manager is unavailable.",
            "PharmaCare",
            MB_OK |
            MB_ICONERROR
        );

        return;
    }


    string today =
        getCurrentDate();


    int count =
        saleManager->countDailySales(
            today
        );


    double income =
        saleManager->calculateDailyIncome(
            today
        );


    string message =
        "Daily Sales\n\n"
        "Date: " +
        today +
        "\n"
        "Number of Sales: " +
        to_string(count) +
        "\n"
        "Daily Income: Rs. " +
        to_string(income);


    MessageBoxA(
        NULL,
        message.c_str(),
        "PharmaCare - Daily Sales",
        MB_OK |
        MB_ICONINFORMATION
    );
}


