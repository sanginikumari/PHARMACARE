    );
}


/* =========================================================
   OPEN MEDICINE FORM
   ========================================================= */

static void openMedicineForm(int mode)
{
    HINSTANCE instance =
        GetModuleHandleA(NULL);

    static bool registered = false;

    if (!registered)
    {
        WNDCLASSA formClass;

        ZeroMemory(
            &formClass,
            sizeof(formClass)
        );

        formClass.lpfnWndProc =
            MedicineFormProcedure;

        formClass.hInstance =
            instance;

        formClass.lpszClassName =
            "PharmaCareMedicineForm";

        formClass.hCursor =
            LoadCursor(
                NULL,
                IDC_ARROW
            );

        formClass.hbrBackground =
            CreateSolidBrush(
                GUI_BACKGROUND
            );

        RegisterClassA(
            &formClass
        );

        registered = true;
    }


    string title;

    if (mode == MED_FORM_ADD)
    {
        title = "Add Medicine";
    }
    else if (mode == MED_FORM_UPDATE)
    {
        title = "Update Medicine";
    }
    else if (mode == MED_FORM_DELETE)
    {
        title = "Delete Medicine";
    }
    else
    {
        title = "Search Medicine";
    }


    g_medicineForm.mode = mode;

    HWND formWindow =
        CreateWindowExA(
            WS_EX_DLGMODALFRAME,
            "PharmaCareMedicineForm",
            title.c_str(),
            WS_OVERLAPPED |
            WS_CAPTION |
            WS_SYSMENU,
            360,
            100,
            620,
            560,
            NULL,
            NULL,
            instance,
            NULL
        );

    g_medicineForm.window =
        formWindow;

    ShowWindow(
        formWindow,
        SW_SHOW
    );

    UpdateWindow(
        formWindow
    );
}


/* =========================================================
   CREATE FORM LABEL
   ========================================================= */

static HWND createFormLabel(
    HWND parent,
    const char* text,
    int x,
    int y,
    int width,
    int height
)
{
    HWND label =
        CreateWindowExA(
            0,
            "STATIC",
            text,
            WS_CHILD | WS_VISIBLE,
            x,
            y,
            width,
            height,
            parent,
            NULL,
            GetModuleHandleA(NULL),
            NULL
        );

    setFont(
        label,
        10,
        true
    );

    return label;
}


/* =========================================================
   CREATE FORM EDIT
   ========================================================= */

static HWND createFormEdit(
    HWND parent,
    int x,
    int y,
    int width,
    int height
)
{
    HWND edit =
        CreateWindowExA(
            WS_EX_CLIENTEDGE,
            "EDIT",
            "",
            WS_CHILD |
            WS_VISIBLE |
            ES_AUTOHSCROLL,
            x,
            y,
            width,
            height,
            parent,
            NULL,
            GetModuleHandleA(NULL),
            NULL
        );

    setFont(
        edit,
        10,
        false
    );

    return edit;
}


/* =========================================================
   MEDICINE FORM PROCEDURE
   ========================================================= */

static LRESULT CALLBACK MedicineFormProcedure(
    HWND window,
    UINT message,
    WPARAM wParam,
    LPARAM lParam
)
{
    switch (message)
    {
        case WM_CREATE:
        {
            int mode =
                g_medicineForm.mode;


            createFormLabel(
                window,
                "Medicine ID",
                45,
                35,
                180,
                25
            );

            g_medicineForm.idEdit =
                createFormEdit(
                    window,
                    235,
                    30,
                    300,
                    32
                );


            createFormLabel(
                window,
                "Medicine Name",
                45,
                85,
                180,
                25
            );

            g_medicineForm.nameEdit =
                createFormEdit(
                    window,
                    235,
                    80,
                    300,
                    32
                );


            createFormLabel(
                window,
                "Category",
                45,
                135,
                180,
                25
            );

            g_medicineForm.categoryEdit =
                createFormEdit(
                    window,
                    235,
                    130,
                    300,
                    32
                );


            createFormLabel(
                window,
                "Price",
                45,
                185,
                180,
                25
            );

            g_medicineForm.priceEdit =
                createFormEdit(
                    window,
                    235,
                    180,
                    300,
                    32
                );


            createFormLabel(
                window,
                "Quantity",
                45,
                235,
                180,
                25
            );

            g_medicineForm.quantityEdit =
                createFormEdit(
                    window,
                    235,
                    230,
                    300,
                    32
                );


            createFormLabel(
                window,
                "Expiry Date",
                45,
                285,
                180,
                25
            );

            g_medicineForm.expiryEdit =
                createFormEdit(
                    window,
                    235,
                    280,
                    300,
                    32
                );


            /* Action button */

            const char* buttonText =
                "Submit";

            if (mode == MED_FORM_ADD)
            {
                buttonText = "Add Medicine";
            }
            else if (mode == MED_FORM_UPDATE)
            {
                buttonText = "Update Medicine";
            }
            else if (mode == MED_FORM_DELETE)
            {
                buttonText = "Delete Medicine";
            }
            else
            {
                buttonText = "Search Medicine";
            }

            g_medicineForm.actionButton =
                CreateWindowExA(
                    0,
                    "BUTTON",
                    buttonText,
                    WS_CHILD |
                    WS_VISIBLE |
                    BS_PUSHBUTTON,
                    235,
                    340,
                    180,
                    42,
                    window,
                    reinterpret_cast<HMENU>(
                        static_cast<INT_PTR>(5001)
                    ),
                    GetModuleHandleA(NULL),
                    NULL
                );

            setFont(
                g_medicineForm.actionButton,
                10,
                true
            );


            /* Close button */

            HWND closeButton =
                CreateWindowExA(
                    0,
                    "BUTTON",
                    "Close",
                    WS_CHILD |
                    WS_VISIBLE |
                    BS_PUSHBUTTON,
                    425,
                    340,
                    110,
                    42,
                    window,
                    reinterpret_cast<HMENU>(
                        static_cast<INT_PTR>(5002)
                    ),
                    GetModuleHandleA(NULL),
                    NULL
                );

            setFont(
                closeButton,
                10,
                true
            );


            /* Result area */

            g_medicineForm.resultLabel =
                CreateWindowExA(
                    0,
                    "STATIC",
                    "",
                    WS_CHILD |
                    WS_VISIBLE |
                    SS_LEFT,
                    45,
                    410,
                    490,
                    90,
                    window,
                    NULL,
                    GetModuleHandleA(NULL),
                    NULL
                );

            setFont(
                g_medicineForm.resultLabel,
                10,
                false
            );

            return 0;
        }


        case WM_COMMAND:
        {
            int id =
                LOWORD(wParam);


            /* Close */

            if (id == 5002)
            {
                DestroyWindow(
                    window
                );

                return 0;
            }


            /* Submit */

            if (id == 5001)
            {
                char idBuffer[100];
                char nameBuffer[200];
                char categoryBuffer[200];
                char priceBuffer[100];
                char quantityBuffer[100];
                char expiryBuffer[100];

                GetWindowTextA(
                    g_medicineForm.idEdit,
                    idBuffer,
                    sizeof(idBuffer)
                );

                GetWindowTextA(
                    g_medicineForm.nameEdit,
                    nameBuffer,
                    sizeof(nameBuffer)
                );

                GetWindowTextA(
                    g_medicineForm.categoryEdit,
                    categoryBuffer,
                    sizeof(categoryBuffer)
                );

                GetWindowTextA(
                    g_medicineForm.priceEdit,
                    priceBuffer,
                    sizeof(priceBuffer)
                );

                GetWindowTextA(
                    g_medicineForm.quantityEdit,
                    quantityBuffer,
                    sizeof(quantityBuffer)
                );

                GetWindowTextA(
                    g_medicineForm.expiryEdit,
                    expiryBuffer,
                    sizeof(expiryBuffer)
                );


                int medicineID =
                    atoi(idBuffer);

                string name =
                    nameBuffer;

                string category =
                    categoryBuffer;

                double price =
                    atof(priceBuffer);

                int quantity =
                    atoi(quantityBuffer);

                string expiry =
                    expiryBuffer;


                /* ---------------- ADD ---------------- */

                if (g_medicineForm.mode ==
                    MED_FORM_ADD)
                {
                    if (medicineID <= 0 ||
                        name.empty() ||
                        category.empty() ||
                        price <= 0 ||
                        quantity < 0 ||
                        expiry.empty())
                    {
                        MessageBoxA(
                            window,
                            "Please fill all medicine fields correctly.",
                            "Validation",
                            MB_OK | MB_ICONWARNING
                        );

                        return 0;
                    }


                    Medicine medicine(
                        medicineID,
                        name,
                        category,
                        price,
                        quantity,
                        expiry
                    );


                    bool success =
                        g_medicineManager->
                        addMedicine(medicine);


                    if (success)
                    {
                        g_dataManager->
                            saveAll(
                                *g_medicineManager,
                                *g_customerManager,
                                *g_billManager,
                                *g_saleManager
                            );

                        MessageBoxA(
                            window,
                            "Medicine added successfully.",
                            "PharmaCare",
                            MB_OK | MB_ICONINFORMATION
                        );

                        DestroyWindow(
                            window
                        );

                        InvalidateRect(
                            NULL,
                            NULL,
                            TRUE
                        );
                    }
                    else
                    {
                        MessageBoxA(
                            window,
                            "Medicine could not be added. ID may already exist or storage is full.",
                            "Add Medicine",
                            MB_OK | MB_ICONWARNING
                        );
                    }

                    return 0;
                }


                /* ---------------- UPDATE ---------------- */

                if (g_medicineForm.mode ==
                    MED_FORM_UPDATE)
                {
                    if (medicineID <= 0 ||
                        name.empty() ||
                        category.empty() ||
                        price <= 0 ||
                        quantity < 0 ||
                        expiry.empty())
                    {
                        MessageBoxA(
                            window,
                            "Please fill all medicine fields correctly.",
                            "Validation",
                            MB_OK | MB_ICONWARNING
                        );

                        return 0;
                    }


                    bool success =
                        g_medicineManager->
                        updateMedicine(
                            medicineID,
                            name,
                            category,
                            price,
                            quantity,
                            expiry
                        );


                    if (success)
                    {
                        g_dataManager->
                            saveAll(
                                *g_medicineManager,
                                *g_customerManager,
                                *g_billManager,
                                *g_saleManager
                            );

                        MessageBoxA(
                            window,
                            "Medicine updated successfully.",
                            "PharmaCare",
                            MB_OK | MB_ICONINFORMATION
                        );

                        DestroyWindow(
                            window
                        );

                        InvalidateRect(
                            NULL,
                            NULL,
                            TRUE
                        );
                    }
                    else
                    {
                        MessageBoxA(
                            window,
                            "Medicine ID was not found.",
                            "Update Medicine",
                            MB_OK | MB_ICONWARNING
                        );
                    }

                    return 0;
                }


                /* ---------------- DELETE ---------------- */

                if (g_medicineForm.mode ==
                    MED_FORM_DELETE)
                {
                    if (medicineID <= 0)
                    {
                        MessageBoxA(
                            window,
                            "Please enter a valid Medicine ID.",
                            "Validation",
                            MB_OK | MB_ICONWARNING
                        );

                        return 0;
                    }


                    bool success =
                        g_medicineManager->
                        deleteMedicine(
                            medicineID
                        );


                    if (success)
                    {
                        g_dataManager->
                            saveAll(
                                *g_medicineManager,
                                *g_customerManager,
                                *g_billManager,
                                *g_saleManager
                            );

                        MessageBoxA(
                            window,
                            "Medicine deleted successfully.",
                            "PharmaCare",
                            MB_OK | MB_ICONINFORMATION
                        );

                        DestroyWindow(
                            window
                        );

                        InvalidateRect(
                            NULL,
                            NULL,
                            TRUE
                        );
                    }
                    else
                    {
                        MessageBoxA(
                            window,
                            "Medicine ID was not found.",
                            "Delete Medicine",
                            MB_OK | MB_ICONWARNING
                        );
                    }

                    return 0;
                }


                /* ---------------- SEARCH ---------------- */

                if (g_medicineForm.mode ==
                    MED_FORM_SEARCH)
                {
                    Medicine* medicine =
                        NULL;

                    if (medicineID > 0)
                    {
                        medicine =
                            g_medicineManager->
                            searchMedicine(
                                medicineID
                            );
                    }
                    else if (!name.empty())
                    {
                        medicine =
                            g_medicineManager->
                            searchMedicine(
                                name
                            );
                    }


                    if (medicine == NULL)
                    {
                        SetWindowTextA(
                            g_medicineForm.resultLabel,
                            "No medicine found."
                        );

                        return 0;
                    }


                    stringstream result;

                    result
                        << "Medicine Found\n"
                        << "ID: "
                        << medicine->getMedicineID()
                        << "\nName: "
                        << medicine->getName()
                        << "\nCategory: "
                        << medicine->getCategory()
                        << "\nPrice: Rs. "
                        << fixed
                        << setprecision(2)
                        << medicine->getPrice()
                        << "\nQuantity: "
                        << medicine->getQuantity()
                        << "\nExpiry: "
                        << medicine->getExpiryDate();


                    SetWindowTextA(
                        g_medicineForm.resultLabel,
                        result.str().c_str()
                    );

                    return 0;
                }
            }

            break;
        }


        case WM_CLOSE:
        {
            DestroyWindow(
                window
            );

            return 0;
        }
    }

    return DefWindowProcA(
        window,
        message,
        wParam,
        lParam
    );
}


