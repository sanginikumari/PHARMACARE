/* =========================================================
   SAVE DATA
   ========================================================= */

void GUI::saveData()
{
    if (dataManager != NULL &&
        medicineManager != NULL &&
        customerManager != NULL &&
        billManager != NULL &&
        saleManager != NULL)
    {
        dataManager->saveAll(
            *medicineManager,
            *customerManager,
            *billManager,
            *saleManager
        );
    }
}
// ============================================================
// PHARMACARE GUI - PART 2
// CUSTOMER MODULE
// ============================================================

static HWND customerFormWindow = NULL;

static HWND customerIdBox = NULL;
static HWND customerNameBox = NULL;
static HWND customerPhoneBox = NULL;
static HWND customerAddressBox = NULL;

static int customerFormMode = 0;
// 1 = Add
// 2 = Update
// 3 = Delete
// 4 = Search


// ------------------------------------------------------------
// Helper: Get text from a Windows control
// ------------------------------------------------------------

static string getCustomerText(HWND control)
{
    char buffer[500];

    GetWindowTextA(
        control,
        buffer,
        sizeof(buffer)
    );

    return string(buffer);
}


// ------------------------------------------------------------
// Helper: Create a customer form control
// ------------------------------------------------------------

static HWND createCustomerEdit(
    HWND parent,
    int x,
    int y,
    int width,
    int height,
    string value
)
{
    HWND editBox =
        CreateWindowExA(
            WS_EX_CLIENTEDGE,
            "EDIT",
            value.c_str(),
            WS_CHILD |
            WS_VISIBLE |
            WS_BORDER |
            ES_AUTOHSCROLL,
            x,
            y,
            width,
            height,
            parent,
            NULL,
            GetModuleHandle(NULL),
            NULL
        );

    SendMessageA(
        editBox,
        WM_SETFONT,
        (WPARAM)GetStockObject(DEFAULT_GUI_FONT),
        TRUE
    );

    return editBox;
}


// ------------------------------------------------------------
// Customer Form Procedure
// ------------------------------------------------------------

static LRESULT CALLBACK CustomerFormProcedure(
    HWND window,
    UINT message,
    WPARAM wParam,
    LPARAM lParam
)
{
    switch (message)
    {
        case WM_CREATE:
        {
            HINSTANCE instance =
                GetModuleHandle(NULL);

            HFONT font =
                (HFONT)GetStockObject(DEFAULT_GUI_FONT);


            // -----------------------------
            // Title
            // -----------------------------

            HWND title =
                CreateWindowExA(
                    0,
                    "STATIC",
                    "Customer Information",
                    WS_CHILD |
                    WS_VISIBLE |
                    SS_LEFT,
                    35,
                    25,
                    400,
                    30,
                    window,
                    NULL,
                    instance,
                    NULL
                );

            SendMessageA(
                title,
                WM_SETFONT,
                (WPARAM)font,
                TRUE
            );


            // -----------------------------
            // Customer ID
            // -----------------------------

            HWND idLabel =
                CreateWindowExA(
                    0,
                    "STATIC",
                    "Customer ID",
                    WS_CHILD |
                    WS_VISIBLE,
                    40,
                    85,
                    150,
                    25,
                    window,
                    NULL,
                    instance,
                    NULL
                );

            SendMessageA(
                idLabel,
                WM_SETFONT,
                (WPARAM)font,
                TRUE
            );


            customerIdBox =
                createCustomerEdit(
                    window,
                    200,
                    80,
                    300,
                    30,
                    ""
                );


            // -----------------------------
            // Customer Name
            // -----------------------------

            HWND nameLabel =
                CreateWindowExA(
                    0,
                    "STATIC",
                    "Customer Name",
                    WS_CHILD |
                    WS_VISIBLE,
                    40,
                    135,
                    150,
                    25,
                    window,
                    NULL,
                    instance,
                    NULL
                );

            SendMessageA(
                nameLabel,
                WM_SETFONT,
                (WPARAM)font,
                TRUE
            );


            customerNameBox =
                createCustomerEdit(
                    window,
                    200,
                    130,
                    300,
                    30,
                    ""
                );


            // -----------------------------
            // Phone
            // -----------------------------

            HWND phoneLabel =
                CreateWindowExA(
                    0,
                    "STATIC",
                    "Phone",
                    WS_CHILD |
                    WS_VISIBLE,
                    40,
                    185,
                    150,
                    25,
                    window,
                    NULL,
                    instance,
                    NULL
                );

            SendMessageA(
                phoneLabel,
                WM_SETFONT,
                (WPARAM)font,
                TRUE
            );


            customerPhoneBox =
                createCustomerEdit(
                    window,
                    200,
                    180,
                    300,
                    30,
                    ""
                );


            // -----------------------------
            // Address
            // -----------------------------

            HWND addressLabel =
                CreateWindowExA(
                    0,
                    "STATIC",
                    "Address",
                    WS_CHILD |
                    WS_VISIBLE,
                    40,
                    235,
                    150,
                    25,
                    window,
                    NULL,
                    instance,
                    NULL
                );

            SendMessageA(
                addressLabel,
                WM_SETFONT,
                (WPARAM)font,
                TRUE
            );


            customerAddressBox =
                CreateWindowExA(
                    WS_EX_CLIENTEDGE,
                    "EDIT",
                    "",
                    WS_CHILD |
                    WS_VISIBLE |
                    WS_BORDER |
                    ES_MULTILINE |
                    ES_AUTOVSCROLL |
                    WS_VSCROLL,
                    200,
                    230,
                    300,
                    80,
                    window,
                    NULL,
                    instance,
                    NULL
                );

            SendMessageA(
                customerAddressBox,
                WM_SETFONT,
                (WPARAM)font,
                TRUE
            );


            // -----------------------------
            // Button
            // -----------------------------

            string buttonText;

            if (customerFormMode == 1)
                buttonText = "Add Customer";
            else if (customerFormMode == 2)
                buttonText = "Update Customer";
            else if (customerFormMode == 3)
                buttonText = "Delete Customer";
            else
                buttonText = "Search Customer";


            HWND actionButton =
                CreateWindowExA(
                    0,
                    "BUTTON",
                    buttonText.c_str(),
                    WS_CHILD |
                    WS_VISIBLE |
                    BS_PUSHBUTTON,
                    200,
                    345,
                    140,
                    40,
                    window,
                    (HMENU)1001,
                    instance,
                    NULL
                );

            SendMessageA(
                actionButton,
                WM_SETFONT,
                (WPARAM)font,
                TRUE
            );


            HWND cancelButton =
                CreateWindowExA(
                    0,
                    "BUTTON",
                    "Close",
                    WS_CHILD |
                    WS_VISIBLE |
                    BS_PUSHBUTTON,
                    360,
                    345,
                    140,
                    40,
                    window,
                    (HMENU)1002,
                    instance,
                    NULL
                );

            SendMessageA(
                cancelButton,
                WM_SETFONT,
                (WPARAM)font,
                TRUE
            );


            return 0;
        }


        case WM_COMMAND:
        {
            int controlID =
                LOWORD(wParam);


            // -----------------------------
            // Action Button
            // -----------------------------

            if (controlID == 1001)
            {
                int id =
                    0;

                string idText =
                    getCustomerText(customerIdBox);

                string name =
                    getCustomerText(customerNameBox);

                string phone =
                    getCustomerText(customerPhoneBox);

                string address =
                    getCustomerText(customerAddressBox);


                if (idText.empty())
                {
                    MessageBoxA(
                        window,
                        "Please enter Customer ID.",
                        "PharmaCare",
                        MB_OK |
                        MB_ICONWARNING
                    );

                    return 0;
                }


                id =
                    atoi(idText.c_str());


                if (id <= 0)
                {
                    MessageBoxA(
                        window,
                        "Customer ID must be greater than zero.",
                        "PharmaCare",
                        MB_OK |
                        MB_ICONWARNING
                    );

                    return 0;
                }


                // -----------------------------
                // ADD
                // -----------------------------

                if (customerFormMode == 1)
                {
                    if (name.empty())
                    {
                        MessageBoxA(
                            window,
                            "Please enter customer name.",
                            "PharmaCare",
                            MB_OK |
                            MB_ICONWARNING
                        );

                        return 0;
                    }


                    Customer customer(
                        id,
                        name,
                        phone,
                        address
                    );


                    if (g_customerManager != NULL &&
                        g_customerManager->addCustomer(customer))
                    {
                        MessageBoxA(
                            window,
                            "Customer added successfully.",
                            "PharmaCare",
                            MB_OK |
                            MB_ICONINFORMATION
                        );

                        DestroyWindow(window);
                    }
                    else
                    {
                        MessageBoxA(
                            window,
                            "Customer could not be added.\n"
                            "The ID may already exist or storage is full.",
                            "PharmaCare",
                            MB_OK |
                            MB_ICONERROR
                        );
                    }
                }


                // -----------------------------
                // UPDATE
                // -----------------------------

                else if (customerFormMode == 2)
                {
                    if (name.empty())
                    {
                        MessageBoxA(
                            window,
                            "Please enter customer name.",
                            "PharmaCare",
                            MB_OK |
                            MB_ICONWARNING
                        );

                        return 0;
                    }


                    if (g_customerManager != NULL &&
                        g_customerManager->updateCustomer(
                            id,
                            name,
                            phone,
                            address
                        ))
                    {
                        MessageBoxA(
                            window,
                            "Customer updated successfully.",
                            "PharmaCare",
                            MB_OK |
                            MB_ICONINFORMATION
                        );

                        DestroyWindow(window);
                    }
                    else
                    {
                        MessageBoxA(
                            window,
                            "Customer not found.",
                            "PharmaCare",
                            MB_OK |
                            MB_ICONERROR
                        );
                    }
                }


                // -----------------------------
                // DELETE
                // -----------------------------

                else if (customerFormMode == 3)
                {
                    int answer =
                        MessageBoxA(
                            window,
                            "Are you sure you want to delete this customer?",
                            "Confirm Delete",
                            MB_YESNO |
                            MB_ICONQUESTION
                        );


                    if (answer == IDYES)
                    {
                        if (g_customerManager != NULL &&
                            g_customerManager->deleteCustomer(id))
                        {
                            MessageBoxA(
                                window,
                                "Customer deleted successfully.",
                                "PharmaCare",
                                MB_OK |
                                MB_ICONINFORMATION
                            );

                            DestroyWindow(window);
                        }
                        else
                        {
                            MessageBoxA(
                                window,
                                "Customer not found.",
                                "PharmaCare",
                                MB_OK |
                                MB_ICONERROR
                            );
                        }
                    }
                }


                // -----------------------------
                // SEARCH
                // -----------------------------

                else if (customerFormMode == 4)
                {
                    if (g_customerManager != NULL)
                    {
                        Customer* customer =
                            g_customerManager->searchCustomer(id);


                        if (customer != NULL)
                        {
                            string result =
                                "Customer Found\n\n"
                                "Customer ID: " +
                                to_string(customer->getCustomerID()) +
                                "\n"
                                "Name: " +
                                customer->getName() +
                                "\n"
                                "Phone: " +
                                customer->getPhone() +
                                "\n"
                                "Address: " +
                                customer->getAddress();


                            MessageBoxA(
                                window,
                                result.c_str(),
                                "Customer Details",
                                MB_OK |
                                MB_ICONINFORMATION
                            );
                        }
                        else
                        {
                            MessageBoxA(
                                window,
                                "Customer not found.",
                                "PharmaCare",
                                MB_OK |
                                MB_ICONWARNING
                            );
                        }
                    }
                }


                return 0;
            }


            // -----------------------------
            // Close Button
            // -----------------------------

            if (controlID == 1002)
            {
                DestroyWindow(window);

                return 0;
            }


            break;
        }


        case WM_CLOSE:
        {
            DestroyWindow(window);

            return 0;
        }


        case WM_DESTROY:
        {
            customerFormWindow = NULL;

            customerIdBox = NULL;
            customerNameBox = NULL;
            customerPhoneBox = NULL;
            customerAddressBox = NULL;

            return 0;
        }
    }


    return DefWindowProcA(
        window,
        message,
        wParam,
        lParam
    );
}


// ------------------------------------------------------------
// Open Customer Form
// ------------------------------------------------------------

static void openCustomerForm(int mode)
{
    customerFormMode =
        mode;


    HINSTANCE instance =
        GetModuleHandle(NULL);


    WNDCLASSA formClass;

    ZeroMemory(
        &formClass,
        sizeof(formClass)
    );


    formClass.lpfnWndProc =
        CustomerFormProcedure;

    formClass.hInstance =
        instance;

    formClass.lpszClassName =
        "PharmaCareCustomerForm";

    formClass.hCursor =
        LoadCursor(
            NULL,
            IDC_ARROW
        );

    formClass.hbrBackground =
        (HBRUSH)(COLOR_WINDOW + 1);


    RegisterClassA(
        &formClass
    );


    string title;


    if (mode == 1)
        title = "PharmaCare - Add Customer";
    else if (mode == 2)
        title = "PharmaCare - Update Customer";
    else if (mode == 3)
        title = "PharmaCare - Delete Customer";
    else
        title = "PharmaCare - Search Customer";


    customerFormWindow =
        CreateWindowExA(
            WS_EX_DLGMODALFRAME,
            "PharmaCareCustomerForm",
            title.c_str(),
            WS_OVERLAPPED |
            WS_CAPTION |
            WS_SYSMENU,
            400,
            120,
            560,
            470,
            NULL,
            NULL,
            instance,
            NULL
        );


    if (customerFormWindow == NULL)
    {
        MessageBoxA(
            NULL,
            "Unable to open customer form.",
            "PharmaCare",
            MB_OK |
            MB_ICONERROR
        );

        return;
    }


    ShowWindow(
        customerFormWindow,
        SW_SHOW
    );

    UpdateWindow(
        customerFormWindow
    );


    EnableWindow(
        g_gui != NULL ? GetParent(customerFormWindow) : NULL,
        FALSE
    );


    MSG message;


    while (
        customerFormWindow != NULL &&
        GetMessageA(
            &message,
            NULL,
            0,
            0
        ) > 0
    )
    {
        TranslateMessage(
            &message
        );

        DispatchMessageA(
            &message
        );
    }


    if (g_gui != NULL)
    {
        // Refresh the main interface.
        // NULL is intentionally used because GUI::mainWindow
        // is private and this function is outside the class.
        InvalidateRect(
            NULL,
            NULL,
            TRUE
        );
    }
}


// ------------------------------------------------------------
// GUI Member Functions
// ------------------------------------------------------------

void GUI::addCustomerWindow()
{
    openCustomerForm(1);
}


void GUI::updateCustomerWindow()
{
    openCustomerForm(2);
}


void GUI::deleteCustomerWindow()
{
    openCustomerForm(3);
}


void GUI::searchCustomerWindow()
{
    openCustomerForm(4);
}


