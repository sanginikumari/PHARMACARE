/* =========================================================
   CONSTRUCTOR
   ========================================================= */

GUI::GUI(
    MedicineManager* medicineManager,
    CustomerManager* customerManager,
    BillManager* billManager,
    SaleManager* saleManager,
    DataManager* dataManager
)
{
    mainWindow = NULL;

    this->medicineManager = medicineManager;
    this->customerManager = customerManager;
    this->billManager = billManager;
    this->saleManager = saleManager;
    this->dataManager = dataManager;

    currentScreen = 0;
    currentBill = NULL;

    g_gui = this;

    g_medicineManager = medicineManager;
    g_customerManager = customerManager;
    g_billManager = billManager;
    g_saleManager = saleManager;
    g_dataManager = dataManager;
}


/* =========================================================
   START GUI
   ========================================================= */

bool GUI::start()
{
    HINSTANCE instance = GetModuleHandleA(NULL);

    WNDCLASSA windowClass;
    ZeroMemory(&windowClass, sizeof(windowClass));

    windowClass.lpfnWndProc = GUI::WindowProcedure;
    windowClass.hInstance = instance;
    windowClass.lpszClassName = "PharmaCareMainWindow";
    windowClass.hCursor = LoadCursor(NULL, IDC_ARROW);
    windowClass.hbrBackground =
        CreateSolidBrush(GUI_BACKGROUND);

    if (!RegisterClassA(&windowClass))
    {
        DWORD errorCode = GetLastError();

        if (errorCode != ERROR_CLASS_ALREADY_EXISTS)
        {
            char message[200];

            sprintf(
                message,
                "RegisterClassA failed.\nError code: %lu",
                errorCode
            );

            MessageBoxA(
                NULL,
                message,
                "PharmaCare Error",
                MB_OK | MB_ICONERROR
            );

            return false;
        }
    }

    mainWindow = CreateWindowExA(
        0,
        "PharmaCareMainWindow",
        "PharmaCare - Pharmacy Store Management",
        WS_OVERLAPPEDWINDOW,
        100,
        50,
        1250,
        760,
        NULL,
        NULL,
        instance,
        this
    );

    if (mainWindow == NULL)
    {
        DWORD errorCode = GetLastError();

        char message[200];

        sprintf(
            message,
            "CreateWindowExA failed.\nError code: %lu",
            errorCode
        );

        MessageBoxA(
            NULL,
            message,
            "PharmaCare Error",
            MB_OK | MB_ICONERROR
        );

        return false;
    }

    ShowWindow(mainWindow, SW_SHOW);
    UpdateWindow(mainWindow);

    MSG message;

    while (GetMessageA(&message, NULL, 0, 0) > 0)
    {
        TranslateMessage(&message);
        DispatchMessageA(&message);
    }

    return true;
}
/* =========================================================
   WINDOW PROCEDURE
   ========================================================= */

LRESULT CALLBACK GUI::WindowProcedure(
    HWND window,
    UINT message,
    WPARAM wParam,
    LPARAM lParam
)
{
    GUI* gui = NULL;

    if (message == WM_NCCREATE)
    {
        CREATESTRUCTA* createData =
            reinterpret_cast<CREATESTRUCTA*>(lParam);

            gui =
            reinterpret_cast<GUI*>(createData->lpCreateParams);

        if (gui != NULL)
        {
            gui->mainWindow = window;
        }

        SetWindowLongPtrA(
            window,
            GWLP_USERDATA,
            reinterpret_cast<LONG_PTR>(gui)
        );
    }
    else
    {
        gui =
            reinterpret_cast<GUI*>(
                GetWindowLongPtrA(window, GWLP_USERDATA)
            );
    }

    if (gui != NULL)
    {
        return gui->handleMessage(
            message,
            wParam,
            lParam
        );
    }

    return DefWindowProcA(
        window,
        message,
        wParam,
        lParam
    );
}


/* =========================================================
   MAIN WINDOW MESSAGE HANDLER
   ========================================================= */

LRESULT GUI::handleMessage(
    UINT message,
    WPARAM wParam,
    LPARAM lParam
)
{
    switch (message)
    {
        case WM_CREATE:
        {
            createNavigation();
            createDashboard();

            showMainControlsForScreen(currentScreen);

            return 0;
        }


        case WM_COMMAND:
        {
            int controlID = LOWORD(wParam);

            switch (controlID)
            {
                /* ---------------- DASHBOARD ---------------- */

                case ID_NAV_DASHBOARD:
                    currentScreen = 0;
                    showMainControlsForScreen(currentScreen);
                    InvalidateRect(mainWindow, NULL, TRUE);
                    return 0;


                /* ---------------- MEDICINE ---------------- */

                case ID_NAV_MEDICINE:
                    currentScreen = 1;
                    showMainControlsForScreen(currentScreen);
                    InvalidateRect(mainWindow, NULL, TRUE);
                    return 0;

                case ID_MED_ADD:
                    addMedicineWindow();
                    return 0;

                case ID_MED_UPDATE:
                    updateMedicineWindow();
                    return 0;

                case ID_MED_DELETE:
                    deleteMedicineWindow();
                    return 0;

                case ID_MED_SEARCH:
                    searchMedicineWindow();
                    return 0;

                case ID_MED_LIST:
                    currentScreen = 1;
                    showMainControlsForScreen(currentScreen);
                    InvalidateRect(mainWindow, NULL, TRUE);
                    return 0;

                case ID_MED_BACK:
                    currentScreen = 0;
                    showMainControlsForScreen(currentScreen);
                    InvalidateRect(mainWindow, NULL, TRUE);
                    return 0;


                /* ---------------- CUSTOMER ---------------- */

                case ID_NAV_CUSTOMER:
                    currentScreen = 2;
                    showMainControlsForScreen(currentScreen);
                    InvalidateRect(mainWindow, NULL, TRUE);
                    return 0;
                case ID_CUST_ADD:
                    addCustomerWindow();
                    return 0;

                case ID_CUST_UPDATE:
                    updateCustomerWindow();
                    return 0;

                case ID_CUST_DELETE:
                    deleteCustomerWindow();
                    return 0;

                case ID_CUST_SEARCH:
                    searchCustomerWindow();
                    return 0;

                case ID_CUST_LIST:
                    currentScreen = 2;
                    showMainControlsForScreen(currentScreen);
                    InvalidateRect(mainWindow, NULL, TRUE);
                    return 0;

                case ID_CUST_BACK:
                    currentScreen = 0;
                    showMainControlsForScreen(currentScreen);
                    InvalidateRect(mainWindow, NULL, TRUE);
                    return 0;    


                /* ---------------- BILLING ---------------- */

                case ID_NAV_BILLING:
                    currentScreen = 3;
                    showMainControlsForScreen(currentScreen);
                    InvalidateRect(mainWindow, NULL, TRUE);
                    return 0;
                case ID_BILL_NEW:
                    createNewBill();
                    return 0;

                case ID_BILL_HISTORY:
                    showSalesHistory();
                    return 0;

                case ID_BILL_REFRESH:
                    currentScreen = 3;
                    showMainControlsForScreen(currentScreen);
                    InvalidateRect(mainWindow, NULL, TRUE);
                    return 0;

                case ID_BILL_BACK:
                    currentScreen = 0;
                    showMainControlsForScreen(currentScreen);
                    InvalidateRect(mainWindow, NULL, TRUE);
                    return 0;    


                /* ---------------- SALES ---------------- */

                case ID_NAV_SALES:
                    currentScreen = 4;
                    showMainControlsForScreen(currentScreen);
                    InvalidateRect(mainWindow, NULL, TRUE);
                    return 0;


                /* ---------------- REPORTS ---------------- */

                case ID_NAV_REPORTS:
                    currentScreen = 5;
                    showMainControlsForScreen(currentScreen);
                    InvalidateRect(mainWindow, NULL, TRUE);
                    return 0;


                /* ---------------- ALERTS ---------------- */

                case ID_NAV_ALERTS:
                    currentScreen = 6;
                    showMainControlsForScreen(currentScreen);
                    InvalidateRect(mainWindow, NULL, TRUE);
                    return 0;


                /* ---------------- EXIT ---------------- */

                case ID_NAV_EXIT:
                    saveData();
                    DestroyWindow(mainWindow);
                    return 0;


                /* ---------------- DASHBOARD QUICK ACTIONS ---------------- */

                case ID_DASH_ADD_MED:
                    addMedicineWindow();
                    return 0;

                case ID_DASH_ADD_CUST:
                    addCustomerWindow();
                    return 0;

                case ID_DASH_NEW_BILL:
                    createNewBill();
                    return 0;

                case ID_DASH_REPORT:
                    currentScreen = 5;
                    showMainControlsForScreen(currentScreen);
                    InvalidateRect(mainWindow, NULL, TRUE);
                    return 0;
            }

            break;
        }


        case WM_PAINT:
        {
            PAINTSTRUCT paintStruct;

            HDC deviceContext =
                BeginPaint(mainWindow, &paintStruct);

            drawInterface(deviceContext);

            EndPaint(mainWindow, &paintStruct);

            return 0;
        }


        case WM_ERASEBKGND:
            return 1;


        case WM_DESTROY:
        {
            saveData();

            PostQuitMessage(0);

            return 0;
        }
    }

    return DefWindowProcA(
        mainWindow,
        message,
        wParam,
        lParam
    );
}


