        deviceContext,
        "Medicine",
        tableLeft + idWidth + 10,
        tableTop + 8,
        nameWidth - 15,
        25,
        GUI_WHITE,
        10,
        true
    );


    drawText(
        deviceContext,
        "Category",
        tableLeft +
        idWidth +
        nameWidth +
        10,
        tableTop + 8,
        categoryWidth - 15,
        25,
        GUI_WHITE,
        10,
        true
    );


    drawText(
        deviceContext,
        "Quantity",
        tableLeft +
        idWidth +
        nameWidth +
        categoryWidth +
        10,
        tableTop + 8,
        quantityWidth - 15,
        25,
        GUI_WHITE,
        10,
        true
    );


    int rowTop =
        tableTop + 40;


    if (medicineManager != NULL)
    {
        for (
            int i = 0;
            i < medicineManager->getCount();
            i++
        )
        {
            Medicine* medicine =
                medicineManager->getMedicineAt(i);


            if (medicine == NULL)
            {
                continue;
            }


            if (medicine->getQuantity() > 10)
            {
                continue;
            }


            COLORREF rowColor =
                (i % 2 == 0)
                ? GUI_WHITE
                : RGB(255, 249, 240);


            drawFilledRect(
                deviceContext,
                tableLeft,
                rowTop,
                tableLeft + totalWidth,
                rowTop + 38,
                rowColor
            );


            stringstream idText;
            idText
                << medicine->getMedicineID();


            stringstream quantityText;
            quantityText
                << medicine->getQuantity();


            drawText(
                deviceContext,
                idText.str().c_str(),
                tableLeft + 10,
                rowTop + 8,
                idWidth - 15,
                22,
                GUI_TEXT,
                10,
                false
            );


            drawText(
                deviceContext,
                medicine->getName().c_str(),
                tableLeft +
                idWidth +
                10,
                rowTop + 8,
                nameWidth - 15,
                22,
                GUI_TEXT,
                10,
                false
            );


            drawText(
                deviceContext,
                medicine->getCategory().c_str(),
                tableLeft +
                idWidth +
                nameWidth +
                10,
                rowTop + 8,
                categoryWidth - 15,
                22,
                GUI_TEXT,
                10,
                false
            );


            drawText(
                deviceContext,
                quantityText.str().c_str(),
                tableLeft +
                idWidth +
                nameWidth +
                categoryWidth +
                10,
                rowTop + 8,
                quantityWidth - 15,
                22,
                GUI_RED,
                10,
                true
            );


            rowTop += 38;
        }
    }


    /* =====================================================
       EXPIRY ALERTS
       ===================================================== */

    int expiryTop =
        520;


    drawText(
        deviceContext,
        "Expired / Near-Expiry Medicines",
        250,
        expiryTop,
        450,
        30,
        GUI_RED,
        16,
        true
    );


    int expiryTableTop =
        expiryTop + 40;


    int expiryIDWidth = 60;
    int expiryNameWidth = 150;
    int expiryCategoryWidth = 130;
    int expiryQuantityWidth = 90;
    int expiryDateWidth = 130;
    int expiryStatusWidth = 150;


    int expiryTotalWidth =
        expiryIDWidth +
        expiryNameWidth +
        expiryCategoryWidth +
        expiryQuantityWidth +
        expiryDateWidth +
        expiryStatusWidth;


    drawFilledRect(
        deviceContext,
        tableLeft,
        expiryTableTop,
        tableLeft + expiryTotalWidth,
        expiryTableTop + 40,
        GUI_RED
    );


    drawText(
        deviceContext,
        "ID",
        tableLeft + 8,
        expiryTableTop + 8,
        expiryIDWidth - 10,
        25,
        GUI_WHITE,
        9,
        true
    );


    drawText(
        deviceContext,
        "Medicine",
        tableLeft +
        expiryIDWidth +
        8,
        expiryTableTop + 8,
        expiryNameWidth - 10,
        25,
        GUI_WHITE,
        9,
        true
    );


    drawText(
        deviceContext,
        "Category",
        tableLeft +
        expiryIDWidth +
        expiryNameWidth +
        8,
        expiryTableTop + 8,
        expiryCategoryWidth - 10,
        25,
        GUI_WHITE,
        9,
        true
    );


    drawText(
        deviceContext,
        "Qty",
        tableLeft +
        expiryIDWidth +
        expiryNameWidth +
        expiryCategoryWidth +
        8,
        expiryTableTop + 8,
        expiryQuantityWidth - 10,
        25,
        GUI_WHITE,
        9,
        true
    );


    drawText(
        deviceContext,
        "Expiry",
        tableLeft +
        expiryIDWidth +
        expiryNameWidth +
        expiryCategoryWidth +
        expiryQuantityWidth +
        8,
        expiryTableTop + 8,
        expiryDateWidth - 10,
        25,
        GUI_WHITE,
        9,
        true
    );


    drawText(
        deviceContext,
        "Status",
        tableLeft +
        expiryIDWidth +
        expiryNameWidth +
        expiryCategoryWidth +
        expiryQuantityWidth +
        expiryDateWidth +
        8,
        expiryTableTop + 8,
        expiryStatusWidth - 10,
        25,
        GUI_WHITE,
        9,
        true
    );


    /*
       The existing MedicineManager already provides the
       expiry-alert count. Here we display the detailed
       medicine information using the stored expiry date.
    */

    int expiryRow =
        expiryTableTop + 40;


    if (medicineManager != NULL)
    {
        time_t currentTime =
            time(NULL);


        for (
            int i = 0;
            i < medicineManager->getCount();
            i++
        )
        {
            Medicine* medicine =
                medicineManager->getMedicineAt(i);


            if (medicine == NULL)
            {
                continue;
            }


            string expiryDate =
                medicine->getExpiryDate();


            int year = 0;
int month = 0;
int day = 0;

/*
   Accept common date formats:

   YYYY-MM-DD
   YYYY/MM/DD
   DD-MM-YYYY
   DD/MM/YYYY
*/

int first = 0;
int second = 0;
int third = 0;

char separator1 = '-';
char separator2 = '-';

if (sscanf(
        expiryDate.c_str(),
        "%d%c%d%c%d",
        &first,
        &separator1,
        &second,
        &separator2,
        &third
    ) == 5)
{
    if (first >= 1900)
    {
        // YYYY-MM-DD
        year = first;
        month = second;
        day = third;
    }
    else if (third >= 1900)
    {
        // DD-MM-YYYY
        day = first;
        month = second;
        year = third;
    }
}

            if (year <= 0 ||
                month <= 0 ||
                day <= 0)
            {
                continue;
            }


            tm expiryTime;

            ZeroMemory(
                &expiryTime,
                sizeof(expiryTime)
            );


            expiryTime.tm_year =
                year - 1900;

            expiryTime.tm_mon =
                month - 1;

            expiryTime.tm_mday =
                day;

            expiryTime.tm_hour =
                12;


            time_t expiryTimestamp =
                mktime(&expiryTime);


            if (expiryTimestamp == -1)
            {
                continue;
            }


            double difference =
                difftime(
                    expiryTimestamp,
                    currentTime
                );


            int daysRemaining =
                static_cast<int>(
                    difference /
                    (24.0 * 60.0 * 60.0)
                );


            bool expired =
                daysRemaining < 0;


            bool nearExpiry =
                !expired &&
                daysRemaining <= 30;


            if (!expired &&
                !nearExpiry)
            {
                continue;
            }


            string status;


            if (expired)
            {
                status = "EXPIRED";
            }
            else
            {
                status = "NEAR EXPIRY";
            }


            COLORREF rowColor =
                expired
                ? RGB(255, 240, 240)
                : RGB(255, 248, 235);


            drawFilledRect(
                deviceContext,
                tableLeft,
                expiryRow,
                tableLeft + expiryTotalWidth,
                expiryRow + 38,
                rowColor
            );


            stringstream idText;

            idText
                << medicine->getMedicineID();


            stringstream quantityText;

            quantityText
                << medicine->getQuantity();


            drawText(
                deviceContext,
                idText.str().c_str(),
                tableLeft + 8,
                expiryRow + 8,
                expiryIDWidth - 10,
                22,
                GUI_TEXT,
                9,
                false
            );


            drawText(
                deviceContext,
                medicine->getName().c_str(),
                tableLeft +
                expiryIDWidth +
                8,
                expiryRow + 8,
                expiryNameWidth - 10,
                22,
                GUI_TEXT,
                9,
                false
            );


            drawText(
                deviceContext,
                medicine->getCategory().c_str(),
                tableLeft +
                expiryIDWidth +
                expiryNameWidth +
                8,
                expiryRow + 8,
                expiryCategoryWidth - 10,
                22,
                GUI_TEXT,
                9,
                false
            );


            drawText(
                deviceContext,
                quantityText.str().c_str(),
                tableLeft +
                expiryIDWidth +
                expiryNameWidth +
                expiryCategoryWidth +
                8,
                expiryRow + 8,
                expiryQuantityWidth - 10,
                22,
                GUI_TEXT,
                9,
                false
            );


            drawText(
                deviceContext,
                expiryDate.c_str(),
                tableLeft +
                expiryIDWidth +
                expiryNameWidth +
                expiryCategoryWidth +
                expiryQuantityWidth +
                8,
                expiryRow + 8,
                expiryDateWidth - 10,
                22,
                GUI_TEXT,
                9,
                false
            );


            drawText(
                deviceContext,
                status.c_str(),
                tableLeft +
                expiryIDWidth +
                expiryNameWidth +
                expiryCategoryWidth +
                expiryQuantityWidth +
                expiryDateWidth +
                8,
                expiryRow + 8,
                expiryStatusWidth - 10,
                22,
                expired
                ? GUI_RED
                : GUI_ORANGE,
                9,
                true
            );


            expiryRow += 38;


            /*
               Keep the screen inside the visible area.
               The full information remains available through
               the alert summary/count and table.
            */
            if (expiryRow > 700)
            {
                break;
            }
        }
    }
}
/* =========================================================
   DRAW BASIC CARD
   ========================================================= */

static void drawCard(
    HDC dc,
    int left,
    int top,
    int right,
    int bottom,
    COLORREF color
)
{
    HBRUSH brush =
        CreateSolidBrush(color);

    RECT rect;
    rect.left = left;
    rect.top = top;
    rect.right = right;
    rect.bottom = bottom;

    FillRect(
        dc,
        &rect,
        brush
    );

    DeleteObject(brush);

    HPEN pen =
        CreatePen(
            PS_SOLID,
            1,
            GUI_LIGHTGRAY
        );

    HPEN oldPen =
        reinterpret_cast<HPEN>(
            SelectObject(dc, pen)
        );

    HBRUSH oldBrush =
        reinterpret_cast<HBRUSH>(
            SelectObject(dc, GetStockObject(NULL_BRUSH))
        );

    Rectangle(
        dc,
        left,
        top,
        right,
        bottom
    );

    SelectObject(
        dc,
        oldBrush
    );

    SelectObject(
        dc,
        oldPen
    );

    DeleteObject(pen);
}


/* =========================================================
   DRAW FILLED RECTANGLE
   ========================================================= */

static void drawFilledRect(
    HDC dc,
    int left,
    int top,
    int right,
    int bottom,
    COLORREF color
)
{
    HBRUSH brush =
        CreateSolidBrush(color);

    RECT rect;

    rect.left = left;
    rect.top = top;
    rect.right = right;
    rect.bottom = bottom;

    FillRect(
        dc,
        &rect,
        brush
    );

    DeleteObject(brush);
}


/* =========================================================
   DRAW TEXT
   ========================================================= */

static void drawText(
    HDC dc,
    const char* text,
    int x,
    int y,
    int width,
    int height,
    COLORREF color,
    int size,
    bool bold
)
{
    HFONT font =
        CreateFontA(
            -size,
            0,
            0,
            0,
            bold ? FW_BOLD : FW_NORMAL,
            FALSE,
            FALSE,
            FALSE,
            ANSI_CHARSET,
            OUT_DEFAULT_PRECIS,
            CLIP_DEFAULT_PRECIS,
            CLEARTYPE_QUALITY,
            DEFAULT_PITCH | FF_SWISS,
            "Segoe UI"
        );

    HFONT oldFont =
        reinterpret_cast<HFONT>(
            SelectObject(dc, font)
        );

    SetTextColor(
        dc,
        color
    );

    SetBkMode(
        dc,
        TRANSPARENT
    );

    RECT rect;

    rect.left = x;
    rect.top = y;
    rect.right = x + width;
    rect.bottom = y + height;

    DrawTextA(
        dc,
        text,
        -1,
        &rect,
        DT_LEFT | DT_VCENTER | DT_SINGLELINE
    );

    SelectObject(
        dc,
        oldFont
    );

    DeleteObject(font);
}


/* =========================================================
   SHOW MESSAGE
   ========================================================= */

void GUI::showMessage(
    string title,
    string message
)
{
    MessageBoxA(
        mainWindow,
        message.c_str(),
        title.c_str(),
        MB_OK | MB_ICONINFORMATION
    );
}


/* =========================================================
   STRING TO INTEGER
   ========================================================= */

int GUI::stringToInteger(string value)
{
    if (value.empty())
    {
        return 0;
    }

    return atoi(
        value.c_str()
    );
}


/* =========================================================
   STRING TO DOUBLE
   ========================================================= */

double GUI::stringToDouble(string value)
{
    if (value.empty())
    {
        return 0.0;
    }

    return atof(
        value.c_str()
    );
}


/* =========================================================
   CURRENT DATE
   ========================================================= */

string GUI::getCurrentDate()
{
    time_t currentTime =
        time(NULL);

    tm* localTime =
        localtime(&currentTime);

    if (localTime == NULL)
    {
        return "";
    }

    char dateBuffer[20];

    sprintf(
        dateBuffer,
        "%04d-%02d-%02d",
        localTime->tm_year + 1900,
        localTime->tm_mon + 1,
        localTime->tm_mday
    );

    return string(dateBuffer);
}


