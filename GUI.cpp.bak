/* =========================================================
   DRAW REPORTS SCREEN
   ========================================================= */

void GUI::drawReportsScreen(HDC deviceContext)
{
    drawText(
        deviceContext,
        "Daily Sales Report",
        250,
        175,
        500,
        35,
        GUI_TEXT,
        20,
        true
    );

    drawText(
        deviceContext,
        "Sales performance for the last 7 days.",
        250,
        210,
        700,
        25,
        GUI_GRAY,
        11,
        false
    );


    int tableLeft = 250;
    int tableTop = 255;

    int dateWidth = 220;
    int countWidth = 180;
    int incomeWidth = 220;

    int totalWidth =
        dateWidth +
        countWidth +
        incomeWidth;


    /* Table Header */

    drawFilledRect(
        deviceContext,
        tableLeft,
        tableTop,
        tableLeft + totalWidth,
        tableTop + 42,
        GUI_PRIMARY
    );


    drawText(
        deviceContext,
        "Date",
        tableLeft + 15,
        tableTop + 10,
        dateWidth - 20,
        25,
        GUI_WHITE,
        10,
        true
    );


    drawText(
        deviceContext,
        "Number of Sales",
        tableLeft + dateWidth + 15,
        tableTop + 10,
        countWidth - 20,
        25,
        GUI_WHITE,
        10,
        true
    );


    drawText(
        deviceContext,
        "Daily Income",
        tableLeft +
        dateWidth +
        countWidth +
        15,
        tableTop + 10,
        incomeWidth - 20,
        25,
        GUI_WHITE,
        10,
        true
    );


    if (saleManager == NULL)
    {
        return;
    }


    time_t currentTime =
        time(NULL);


    int rowTop =
        tableTop + 42;


    double sevenDayTotal =
        0.0;


    for (int i = 0; i < 7; i++)
    {
        time_t dayTime =
            currentTime -
            static_cast<time_t>(i) *
            24 *
            60 *
            60;


        tm* day =
            localtime(&dayTime);


        if (day == NULL)
        {
            continue;
        }


        char dateBuffer[20];


        sprintf(
            dateBuffer,
            "%04d-%02d-%02d",
            day->tm_year + 1900,
            day->tm_mon + 1,
            day->tm_mday
        );


        string date =
            dateBuffer;


        int salesCount =
            saleManager->countDailySales(
                date
            );


        double income =
            saleManager->calculateDailyIncome(
                date
            );


        sevenDayTotal +=
            income;


        COLORREF rowColor =
            (i % 2 == 0)
            ? GUI_WHITE
            : RGB(248, 250, 253);


        drawFilledRect(
            deviceContext,
            tableLeft,
            rowTop,
            tableLeft + totalWidth,
            rowTop + 42,
            rowColor
        );


        drawText(
            deviceContext,
            date.c_str(),
            tableLeft + 15,
            rowTop + 10,
            dateWidth - 20,
            25,
            GUI_TEXT,
            10,
            false
        );


        stringstream countText;

        countText
            << salesCount;


        drawText(
            deviceContext,
            countText.str().c_str(),
            tableLeft +
            dateWidth +
            15,
            rowTop + 10,
            countWidth - 20,
            25,
            GUI_TEXT,
            10,
            false
        );


        stringstream incomeText;

        incomeText
            << fixed
            << setprecision(2)
            << "Rs. "
            << income;


        drawText(
            deviceContext,
            incomeText.str().c_str(),
            tableLeft +
            dateWidth +
            countWidth +
            15,
            rowTop + 10,
            incomeWidth - 20,
            25,
            GUI_GREEN,
            10,
            true
        );


        rowTop += 42;
    }


    /* Seven-day total */

    drawCard(
        deviceContext,
        250,
        610,
        870,
        690,
        GUI_WHITE
    );


    stringstream totalText;

    totalText
        << "7-Day Total Income: Rs. "
        << fixed
        << setprecision(2)
        << sevenDayTotal;


    drawText(
        deviceContext,
        totalText.str().c_str(),
        275,
        630,
        560,
        30,
        GUI_PRIMARY,
        14,
        true
    );
}


