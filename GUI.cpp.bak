/* =========================================================
   CREATE MAIN BUTTON
   ========================================================= */

static HWND createMainButton(
    HWND parent,
    const char* text,
    int id,
    int x,
    int y,
    int width,
    int height
)
{
    HWND button = CreateWindowExA(
        0,
        "BUTTON",
        text,
        WS_CHILD | WS_VISIBLE | BS_PUSHBUTTON,
        x,
        y,
        width,
        height,
        parent,
        reinterpret_cast<HMENU>(static_cast<INT_PTR>(id)),
        GetModuleHandleA(NULL),
        NULL
    );

    if (button != NULL)
    {
        setFont(
            button,
            10,
            true
        );
    }

    return button;
}


/* =========================================================
   SET CONTROL FONT
   ========================================================= */

static void setFont(
    HWND control,
    int size,
    bool bold
)
{
    HFONT font = CreateFontA(
        -size,
        0,
        0,
        0,
        bold ? FW_BOLD : FW_NORMAL,
        FALSE,
        FALSE,
        FALSE,
        ANSI_CHARSET,
        OUT_DEFAULT_PRECIS,
        CLIP_DEFAULT_PRECIS,
        CLEARTYPE_QUALITY,
        DEFAULT_PITCH | FF_SWISS,
        "Segoe UI"
    );

    SendMessageA(
        control,
        WM_SETFONT,
        reinterpret_cast<WPARAM>(font),
        TRUE
    );
}


/* =========================================================
   HIDE MAIN CONTROLS
   ========================================================= */

static void hideMainControls()
{
    HWND controls[] =
    {
        hNavDashboard,
        hNavMedicine,
        hNavCustomer,
        hNavBilling,
        hNavSales,
        hNavReports,
        hNavAlerts,
        hNavExit,

        hMedAdd,
        hMedUpdate,
        hMedDelete,
        hMedSearch,
        hMedList,
        hMedBack,
        hCustAdd,
        hCustUpdate,
        hCustDelete,
        hCustSearch,
        hCustList,
        hCustBack,
        hBillNew,
        hBillHistory,
        hBillRefresh,
        hBillBack,

        hDashAddMed,
        hDashAddCust,
        hDashNewBill,
        hDashReport
    };

    int count =
        sizeof(controls) / sizeof(controls[0]);

    for (int i = 0; i < count; i++)
    {
        if (controls[i] != NULL)
        {
            ShowWindow(
                controls[i],
                SW_HIDE
            );
        }
    }
}


/* =========================================================
   SHOW CONTROLS ACCORDING TO CURRENT SCREEN
   ========================================================= */

static void showMainControlsForScreen(int screen)
{
    hideMainControls();

    /* Navigation is always visible */

    HWND navigation[] =
    {
        hNavDashboard,
        hNavMedicine,
        hNavCustomer,
        hNavBilling,
        hNavSales,
        hNavReports,
        hNavAlerts,
        hNavExit
    };

    int navigationCount =
        sizeof(navigation) /
        sizeof(navigation[0]);

    for (int i = 0; i < navigationCount; i++)
    {
        if (navigation[i] != NULL)
        {
            ShowWindow(
                navigation[i],
                SW_SHOW
            );
        }
    }


    /* Dashboard */

    if (screen == 0)
    {
        ShowWindow(
            hDashAddMed,
            SW_SHOW
        );

        ShowWindow(
            hDashAddCust,
            SW_SHOW
        );

        ShowWindow(
            hDashNewBill,
            SW_SHOW
        );

        ShowWindow(
            hDashReport,
            SW_SHOW
        );
    }


    /* Medicine */

    if (screen == 1)
    {
        ShowWindow(hMedAdd, SW_SHOW);
        ShowWindow(hMedUpdate, SW_SHOW);
        ShowWindow(hMedDelete, SW_SHOW);
        ShowWindow(hMedSearch, SW_SHOW);
        ShowWindow(hMedList, SW_SHOW);
        ShowWindow(hMedBack, SW_SHOW);
    }
    /* Customer */

    if (screen == 2)
    {
        ShowWindow(hCustAdd, SW_SHOW);
        ShowWindow(hCustUpdate, SW_SHOW);
        ShowWindow(hCustDelete, SW_SHOW);
        ShowWindow(hCustSearch, SW_SHOW);
        ShowWindow(hCustList, SW_SHOW);
        ShowWindow(hCustBack, SW_SHOW);
    }
    if (screen == 3)
{
    ShowWindow(hBillNew, SW_SHOW);
    ShowWindow(hBillHistory, SW_SHOW);
    ShowWindow(hBillRefresh, SW_SHOW);
    ShowWindow(hBillBack, SW_SHOW);
}
}


/* =========================================================
   DRAW INTERFACE
   ========================================================= */

void GUI::drawInterface(HDC deviceContext)
{
    RECT clientRect;

    GetClientRect(
        mainWindow,
        &clientRect
    );

    drawFilledRect(
        deviceContext,
        0,
        0,
        clientRect.right,
        clientRect.bottom,
        GUI_BACKGROUND
    );


    /* Sidebar */

    drawFilledRect(
        deviceContext,
        0,
        0,
        230,
        clientRect.bottom,
        GUI_SIDEBAR
    );


    /* Sidebar top brand area */

    drawFilledRect(
        deviceContext,
        0,
        0,
        230,
        85,
        GUI_PRIMARY
    );

    drawText(
        deviceContext,
        "PharmaCare",
        20,
        18,
        190,
        30,
        GUI_WHITE,
        22,
        true
    );

    drawText(
        deviceContext,
        "Pharmacy Management",
        20,
        50,
        190,
        22,
        RGB(220, 230, 255),
        10,
        false
    );


    /* Main title */

    if (currentScreen == 2 || currentScreen == 3)
{
    drawText(
        deviceContext,
        "PharmaCare Pharmacy Store Management",
        250,
        35,
        850,
        40,
        GUI_TEXT,
        24,
        true
    );

    drawText(
        deviceContext,
        "Billing",
        250,
        80,
        500,
        35,
        RGB(35, 45, 65),
        20,
        true
    );
}
else
{
    drawText(
        deviceContext,
        "PharmaCare Pharmacy Store",
        250,
        35,
        700,
        40,
        GUI_TEXT,
        24,
        true
    );

    drawText(
        deviceContext,
        "Professional medicine, customer and billing management",
        250,
        72,
        750,
        25,
        GUI_GRAY,
        11,
        false
    );
}
    switch (currentScreen)
    {
        case 0:
            drawDashboard(deviceContext);
            break;

        case 1:
            drawMedicineScreen(deviceContext);
            break;

        case 2:
            drawCustomerScreen(deviceContext);
            break;

        case 3:
            drawBillingScreen(deviceContext);
            break;

        case 4:
            drawSalesScreen(deviceContext);
            break;

        case 5:
            drawReportsScreen(deviceContext);
            break;

        case 6:
            drawAlerts(deviceContext);
            break;

        default:
            drawDashboard(deviceContext);
            break;
    }
}


/* =========================================================
   DRAW DASHBOARD
   ========================================================= */

void GUI::drawDashboard(HDC deviceContext)
{
    int medicineCount = 0;
    int customerCount = 0;
    int salesCount = 0;
    double income = 0.0;
    int lowStock = 0;
    int expiryAlerts = 0;

    if (medicineManager != NULL)
    {
        medicineCount =
            medicineManager->getCount();

        lowStock =
            medicineManager->countLowStock(10);

        expiryAlerts =
            medicineManager->countExpiredOrNearExpiry();
    }

    if (customerManager != NULL)
    {
        customerCount =
            customerManager->getCount();
    }

    if (saleManager != NULL)
    {
        salesCount =
            saleManager->getCount();

        income =
            saleManager->calculateTotalIncome();
    }


    /* Dashboard subtitle */

    drawText(
        deviceContext,
        "Overview",
        250,
        115,
        250,
        30,
        GUI_TEXT,
        16,
        true
    );


    /* ---------------- CARD 1 ---------------- */

    drawCard(
        deviceContext,
        250,
        155,
        475,
        275,
        GUI_WHITE
    );

    drawText(
        deviceContext,
        "TOTAL MEDICINES",
        275,
        180,
        180,
        25,
        GUI_GRAY,
        10,
        true
    );

    {
        stringstream ss;
        ss << medicineCount;

        drawText(
            deviceContext,
            ss.str().c_str(),
            275,
            215,
            170,
            45,
            GUI_PRIMARY,
            30,
            true
        );
    }

    drawText(
        deviceContext,
        "Items in inventory",
        275,
        255,
        170,
        22,
        GUI_GRAY,
        10,
        false
    );


    /* ---------------- CARD 2 ---------------- */

    drawCard(
        deviceContext,
        500,
        155,
        725,
        275,
        GUI_WHITE
    );

    drawText(
        deviceContext,
        "TOTAL CUSTOMERS",
        525,
        180,
        180,
        25,
        GUI_GRAY,
        10,
        true
    );

    {
        stringstream ss;
        ss << customerCount;

        drawText(
            deviceContext,
            ss.str().c_str(),
            525,
            215,
            170,
            45,
            GUI_PURPLE,
            30,
            true
        );
    }

    drawText(
        deviceContext,
        "Registered customers",
        525,
        255,
        190,
        22,
        GUI_GRAY,
        10,
        false
    );


    /* ---------------- CARD 3 ---------------- */

    drawCard(
        deviceContext,
        250,
        295,
        475,
        415,
        GUI_WHITE
    );

    drawText(
        deviceContext,
        "TOTAL SALES",
        275,
        320,
        180,
        25,
        GUI_GRAY,
        10,
        true
    );

    {
        stringstream ss;
        ss << salesCount;

        drawText(
            deviceContext,
            ss.str().c_str(),
            275,
            355,
            170,
            45,
            GUI_GREEN,
            30,
            true
        );
    }

    drawText(
        deviceContext,
        "Completed transactions",
        275,
        395,
        190,
        22,
        GUI_GRAY,
        10,
        false
    );


    /* ---------------- CARD 4 ---------------- */

    drawCard(
        deviceContext,
        500,
        295,
        725,
        415,
        GUI_WHITE
    );

    drawText(
        deviceContext,
        "TOTAL INCOME",
        525,
        320,
        180,
        25,
        GUI_GRAY,
        10,
        true
    );

    {
        stringstream ss;

        ss << fixed
           << setprecision(2)
           << "Rs. "
           << income;

        drawText(
            deviceContext,
            ss.str().c_str(),
            525,
            355,
            190,
            45,
            GUI_ORANGE,
            22,
            true
        );
    }

    drawText(
        deviceContext,
        "Overall sales income",
        525,
        395,
        190,
        22,
        GUI_GRAY,
        10,
        false
    );


    /* ---------------- ALERT SUMMARY ---------------- */

    drawCard(
        deviceContext,
        750,
        155,
        1225,
        415,
        GUI_WHITE
    );

    drawText(
        deviceContext,
        "Inventory Alerts",
        780,
        180,
        250,
        30,
        GUI_TEXT,
        17,
        true
    );


    drawFilledRect(
        deviceContext,
        780,
        230,
        1195,
        295,
        RGB(255, 247, 235)
    );

    drawText(
        deviceContext,
        "Low Stock",
        805,
        245,
        200,
        25,
        GUI_ORANGE,
        12,
        true
    );

    {
        stringstream ss;
        ss << lowStock << " medicine(s)";

        drawText(
            deviceContext,
            ss.str().c_str(),
            1030,
            245,
            150,
            25,
            GUI_TEXT,
            11,
            true
        );
    }


    drawFilledRect(
        deviceContext,
        780,
        315,
        1195,
        380,
        RGB(255, 240, 240)
    );

    drawText(
        deviceContext,
        "Expiry Alerts",
        805,
        330,
        200,
        25,
        GUI_RED,
        12,
        true
    );

    {
        stringstream ss;
        ss << expiryAlerts << " medicine(s)";

        drawText(
            deviceContext,
            ss.str().c_str(),
            1030,
            330,
            150,
            25,
            GUI_TEXT,
            11,
            true
        );
    }


    /* Quick action heading */

    drawText(
        deviceContext,
        "Quick Actions",
        250,
        505,
        250,
        30,
        GUI_TEXT,
        16,
        true
    );
}


/* =========================================================
   DRAW MEDICINE SCREEN
   ========================================================= */

void GUI::drawMedicineScreen(HDC deviceContext)
{
    drawText(
        deviceContext,
        "Medicine Management",
        250,
        175,
        400,
        35,
        GUI_TEXT,
        20,
        true
    );

    drawText(
        deviceContext,
        "Manage medicines, stock quantity, pricing and expiry dates.",
        250,
        208,
        650,
        25,
        GUI_GRAY,
        11,
        false
    );


    /* Table header */

    int tableLeft = 250;
    int tableTop = 255;

    int colID = 70;
    int colName = 180;
    int colCategory = 150;
    int colPrice = 110;
    int colQuantity = 110;
    int colExpiry = 140;

    int totalWidth =
        colID +
        colName +
        colCategory +
        colPrice +
        colQuantity +
        colExpiry;


    drawFilledRect(
        deviceContext,
        tableLeft,
        tableTop,
        tableLeft + totalWidth,
        tableTop + 42,
        GUI_PRIMARY
    );


    drawText(
        deviceContext,
        "ID",
        tableLeft + 10,
        tableTop + 10,
        colID - 15,
        25,
        GUI_WHITE,
        10,
        true
    );

    drawText(
        deviceContext,
        "Medicine Name",
        tableLeft + colID + 10,
        tableTop + 10,
        colName - 15,
        25,
        GUI_WHITE,
        10,
        true
    );

    drawText(
        deviceContext,
        "Category",
        tableLeft + colID + colName + 10,
        tableTop + 10,
        colCategory - 15,
        25,
        GUI_WHITE,
        10,
        true
    );

    drawText(
        deviceContext,
        "Price",
        tableLeft + colID + colName + colCategory + 10,
        tableTop + 10,
        colPrice - 15,
        25,
        GUI_WHITE,
        10,
        true
    );

    drawText(
        deviceContext,
        "Quantity",
        tableLeft +
        colID +
        colName +
        colCategory +
        colPrice +
        10,
        tableTop + 10,
        colQuantity - 15,
        25,
        GUI_WHITE,
        10,
        true
    );

    drawText(
        deviceContext,
        "Expiry Date",
        tableLeft +
        colID +
        colName +
        colCategory +
        colPrice +
        colQuantity +
        10,
        tableTop + 10,
        colExpiry - 15,
        25,
        GUI_WHITE,
        10,
        true
    );


    /* Table rows */

    if (medicineManager == NULL)
    {
        return;
    }

    int rowTop = tableTop + 42;

    for (int i = 0;
         i < medicineManager->getCount() && i < 12;
         i++)
    {
        Medicine* medicine =
            medicineManager->getMedicineAt(i);

        if (medicine == NULL)
        {
            continue;
        }

        COLORREF rowColor =
            (i % 2 == 0)
            ? GUI_WHITE
            : RGB(248, 250, 253);

        drawFilledRect(
            deviceContext,
            tableLeft,
            rowTop,
            tableLeft + totalWidth,
            rowTop + 38,
            rowColor
        );


        stringstream id;
        id << medicine->getMedicineID();

        stringstream price;
        price << fixed
              << setprecision(2)
              << medicine->getPrice();

        stringstream quantity;
        quantity << medicine->getQuantity();


        drawText(
            deviceContext,
            id.str().c_str(),
            tableLeft + 10,
            rowTop + 8,
            colID - 15,
            22,
            GUI_TEXT,
            10,
            false
        );

        drawText(
            deviceContext,
            medicine->getName().c_str(),
            tableLeft + colID + 10,
            rowTop + 8,
            colName - 15,
            22,
            GUI_TEXT,
            10,
            false
        );

        drawText(
            deviceContext,
            medicine->getCategory().c_str(),
            tableLeft + colID + colName + 10,
            rowTop + 8,
            colCategory - 15,
            22,
            GUI_TEXT,
            10,
            false
        );

        drawText(
            deviceContext,
            price.str().c_str(),
            tableLeft +
            colID +
            colName +
            colCategory +
            10,
            rowTop + 8,
            colPrice - 15,
            22,
            GUI_TEXT,
            10,
            false
        );

        drawText(
            deviceContext,
            quantity.str().c_str(),
            tableLeft +
            colID +
            colName +
            colCategory +
            colPrice +
            10,
            rowTop + 8,
            colQuantity - 15,
            22,
            GUI_TEXT,
            10,
            false
        );

        drawText(
            deviceContext,
            medicine->getExpiryDate().c_str(),
            tableLeft +
            colID +
            colName +
            colCategory +
            colPrice +
            colQuantity +
            10,
            rowTop + 8,
            colExpiry - 15,
            22,
            GUI_TEXT,
            10,
            false
        );


        rowTop += 38;
    }
}


/* =========================================================
   DRAW CUSTOMER SCREEN
   ========================================================= */

void GUI::drawCustomerScreen(HDC deviceContext)
{
    
    int x = 270;
    int y = 205;

    // Table header
    HBRUSH headerBrush =
        CreateSolidBrush(RGB(70, 90, 150));

    RECT headerRect =
    {
        x,
        y,
        1150,
        y + 48
    };

    FillRect(
        deviceContext,
        &headerRect,
        headerBrush
    );

    DeleteObject(headerBrush);

    drawText(
        deviceContext,
        "Customer ID",
        x + 15,
        y + 10,
        110,
        30,
        RGB(255, 255, 255),
        12,
        true
    );

    drawText(
        deviceContext,
        "Name",
        x + 145,
        y + 10,
        180,
        30,
        RGB(255, 255, 255),
        15,
        true
    );

    drawText(
        deviceContext,
        "Phone",
        x + 365,
        y + 10,
        140,
        30,
        RGB(255, 255, 255),
        15,
        true
    );

    drawText(
        deviceContext,
        "Address",
        x + 535,
        y + 10,
        300,
        30,
        RGB(255, 255, 255),
        15,
        true
    );

    int rowY = y + 48;

    for (
        int i = 0;
        i < customerManager->getCount() && i < 10;
        i++
    )
    {
        Customer* customer =
            customerManager->getCustomerAt(i);

        if (customer == NULL)
            continue;

        COLORREF rowColor;

        if (i % 2 == 0)
            rowColor = RGB(248, 250, 253);
        else
            rowColor = RGB(238, 243, 250);

        HBRUSH rowBrush =
            CreateSolidBrush(rowColor);

        RECT rowRect =
        {
            x,
            rowY,
            1150,
            rowY + 40
        };

        FillRect(
            deviceContext,
            &rowRect,
            rowBrush
        );

        DeleteObject(rowBrush);

        string customerID =
            to_string(customer->getCustomerID());

        string name =
            customer->getName();

        string phone =
            customer->getPhone();

        string address =
            customer->getAddress();

        drawText(
            deviceContext,
            customerID.c_str(),
            x + 15,
            rowY + 10,
            110,
            30,
            RGB(45, 55, 70),
            11,
            false
        );

        drawText(
            deviceContext,
            name.c_str(),
            x + 145,
            rowY + 10,
            180,
            30,
            RGB(45, 55, 70),
            11,
            false
        );

        drawText(
            deviceContext,
            phone.c_str(),
            x + 365,
            rowY + 10,
            140,
            30,
            RGB(45, 55, 70),
            11,
            false
        );

        drawText(
            deviceContext,
            address.c_str(),
            x + 535,
            rowY + 10,
            300,
            30,
            RGB(45, 55, 70),
            11,
            false
        );

        rowY += 40;
    }

    // Table border
    HPEN borderPen =
        CreatePen(
            PS_SOLID,
            1,
            RGB(215, 220, 230)
        );

    HPEN oldPen =
        (HPEN)SelectObject(
            deviceContext,
            borderPen
        );

    HBRUSH oldBrush =
        (HBRUSH)SelectObject(
            deviceContext,
            GetStockObject(NULL_BRUSH)
        );

    Rectangle(
        deviceContext,
        x,
        y,
        1150,
        rowY
    );

    SelectObject(
        deviceContext,
        oldBrush
    );

    SelectObject(
        deviceContext,
        oldPen
    );

    DeleteObject(borderPen);

    if (customerManager->getCount() == 0)
    {
        drawText(
            deviceContext,
            "No customers found.",
            500,
            390,
            300,
            35,
            RGB(120, 130, 145),
            18,
            false
        );
    }
}

/* =========================================================
   DRAW BILLING SCREEN
   ========================================================= */

void GUI::drawBillingScreen(HDC deviceContext)
{
    
    // Summary cards
    int cardY = 190;

    // Bill number card
    HBRUSH blueBrush =
        CreateSolidBrush(RGB(232, 240, 255));

    RECT billCard =
    {
        270,
        cardY,
        540,
        cardY + 105
    };

    FillRect(
        deviceContext,
        &billCard,
        blueBrush
    );

    DeleteObject(blueBrush);

    drawText(
        deviceContext,
        "NEXT BILL NUMBER",
        290,
        cardY + 18,
        220,
        25,
        RGB(80, 95, 120),
        13,
        true
    );

    string nextBill =
        to_string(billManager->getNextBillNumber());

    drawText(
        deviceContext,
        nextBill.c_str(),
        290,
        cardY + 48,
        200,
        40,
        RGB(45, 75, 150),
        20,
        true
    );

    // Total bills card
    HBRUSH greenBrush =
        CreateSolidBrush(RGB(232, 249, 240));

    RECT totalCard =
    {
        560,
        cardY,
        830,
        cardY + 105
    };

    FillRect(
        deviceContext,
        &totalCard,
        greenBrush
    );

    DeleteObject(greenBrush);

    drawText(
        deviceContext,
        "TOTAL BILLS",
        580,
        cardY + 18,
        200,
        25,
        RGB(80, 105, 90),
        13,
        true
    );

    string totalBills =
        to_string(billManager->getCount());

    drawText(
        deviceContext,
        totalBills.c_str(),
        580,
        cardY + 48,
        200,
        40,
        RGB(40, 130, 80),
        20,
        true
    );

    
}
